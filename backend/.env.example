# Copy to .env for local development: cp .env.example .env

# Where uploaded audio + separated stems are stored
STORAGE_DIR=./storage/jobs

# How long a job's files live before the background task deletes them
JOB_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# Reject uploads larger than this
MAX_FILE_SIZE_MB=60

# htdemucs (fast, default) or htdemucs_ft (slower, higher quality)
DEMUCS_MODEL=htdemucs

# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://stemcraft.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Local dev port (Docker deployments use PORT=7860 / Render's injected PORT)
PORT=8000
